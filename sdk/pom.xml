<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>in.vidyalai</groupId>
        <artifactId>claude-agent-sdk-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>claude-agent-sdk-java</artifactId>
    <packaging>jar</packaging>

    <name>Claude Agent SDK Java</name>
    <description>Unofficial Claude Agent Java SDK</description>
    <!-- Declared explicitly: an inherited <url> gets the module's artifactId
         appended, which would publish a 404 link as the project URL. -->
    <url>https://github.com/vidyalai-in/claude-agent-sdk-java</url>

    <properties>
        <!-- This is the only module that gets published; the parent sets this to
             true so the parent POM and the examples module are never deployed. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- JSON serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Nullable annotations -->
        <!-- Validates tool arguments against a tool's declared inputSchema
             before the handler runs; the MCP spec requires servers to validate
             tool inputs. -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- OpenTelemetry (test-scope only) so the OTEL trace-context
             propagation tests can stand up a real propagator + active span.
             The SDK code uses reflection, so OpenTelemetry is NOT a runtime
             dependency for consumers. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-context</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <!-- Copy dependencies to target/dependency for java -cp usage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generate SdkVersion class from template -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-version-class</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Configure Javadoc generation -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Disable strict doclint checking -->
                    <doclint>none</doclint>
                    <!-- Don't fail build on javadoc errors -->
                    <failOnError>false</failOnError>
                    <failOnWarnings>false</failOnWarnings>
                    <!-- Additional options -->
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Generate source JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Publishing profiles.

        The two targets cannot share a single `mvn deploy` run: the
        central-publishing-maven-plugin registers itself as a build extension and
        replaces the deploy phase wholesale, so it would swallow any
        distributionManagement repository. Deploy twice instead:

            mvn clean deploy -Pcentral -DskipTests    # Maven Central (do this first)
            mvn deploy -Pgithub -DskipTests -pl sdk   # GitHub Packages

        Central first, because a Central release is permanent and cannot be
        deleted or overwritten - if its validation rejects the bundle you can
        retry the same version, but only while nothing has been published yet.
    -->
    <profiles>
        <!-- Maven Central via the Central Portal (central.sonatype.com). -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <!-- Central requires a detached GPG signature for every
                         artifact. Locally the passphrase comes from gpg-agent;
                         in CI it comes from the MAVEN_GPG_PASSPHRASE env var,
                         which needs loopback pinentry to be readable. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- Matches the <server> id in settings.xml holding
                                 the Central Portal user token. -->
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload, validate, and release automatically - no
                                 manual click in the Portal UI. The build blocks
                                 until validation passes, so a rejected bundle
                                 fails the deploy before anything is released;
                                 once validated, the Portal publishes on its own. -->
                            <autoPublish>true</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- GitHub Packages. Kept for backwards compatibility with consumers
             who already point at it; requires a PAT even for public artifacts. -->
        <profile>
            <id>github</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <name>GitHub Packages</name>
                    <url>https://maven.pkg.github.com/vidyalai-in/claude-agent-sdk-java</url>
                </repository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
